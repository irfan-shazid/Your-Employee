# ───────────── Server ─────────────
NODE_ENV=development
PORT=4000

# Public URL of THIS server as seen by the phone and by SSLCommerz / Stripe / Google.
#   • Same Wi-Fi testing:  http://<your-PC-LAN-IP>:4000   (e.g. http://192.168.0.105:4000)
#   • Google sign-in needs HTTPS → use a tunnel (cloudflared / ngrok) or your deployed URL
BETTER_AUTH_URL=http://192.168.0.105:4000
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ───────────── Neon Postgres ─────────────
# Pooled connection (host contains "-pooler") — used by the running server
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct connection (no "-pooler") — used by Prisma CLI for migrations
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ───────────── Google sign-in (optional) ─────────────
# Google Cloud Console → Credentials → OAuth client ID (type: Web application)
# Authorized redirect URI:  <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────────── App ─────────────
# Must match "scheme" in mobile/app.json
APP_SCHEME=youremployee
# Extra browser origins (Expo web dev server, admin web build…)
CORS_ORIGINS=http://localhost:8081
# true when deployed behind a proxy / load balancer (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=false

# ───────────── SSLCommerz ─────────────
# Sandbox store: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# false = sandbox, true = live
SSLCOMMERZ_IS_LIVE=false

# ───────────── Stripe (optional, international cards) ─────────────
# Dashboard → Developers → API keys. Leave empty to hide Stripe in the app.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint <BETTER_AUTH_URL>/api/payments/stripe/webhook
# with events checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed and checkout.session.expired.
# Local testing:  stripe listen --forward-to localhost:4000/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Stripe charges in its own currency and prices (Stripe's minimum charge is about USD 0.50,
# so the BDT prices below can't be used). Decimals allowed.
STRIPE_CURRENCY=usd
STRIPE_WORKER_MONTHLY_FEE=1.00
STRIPE_JOB_POST_FEE=0.50
STRIPE_HIRE_FEE=0.50

# ───────────── Pricing (BDT, SSLCommerz) ─────────────
WORKER_MONTHLY_FEE=50
JOB_POST_FEE=10
HIRE_FEE=10
SUBSCRIPTION_DAYS=30

# ───────────── First admin (created by `npm run db:seed`) ─────────────
ADMIN_EMAIL=admin@youremployee.app
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Admin
